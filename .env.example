# ─── Database ────────────────────────────────────────────────────────────────
# Local docker:   postgres://postgres:postgres@localhost:54329/floodguard
# Supabase:       Project Settings → Database → Connection string.
#                 Use the "Transaction pooler" URI (port 6543) for Vercel, and the
#                 "Direct"/"Session pooler" URI when running migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/floodguard

# ─── Region ──────────────────────────────────────────────────────────────────
# Must match a file in config/regions/. Set both (the NEXT_PUBLIC one is used by the browser).
REGION=lokoja
NEXT_PUBLIC_REGION=lokoja

# ─── Auth ────────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies. `openssl rand -hex 32`
AUTH_SECRET=change-me-to-a-long-random-string
# Password for the seeded operator@floodguard.demo / admin@floodguard.demo accounts.
SEED_OPERATOR_PASSWORD=floodguard-demo

# ─── Demo mode ───────────────────────────────────────────────────────────────
# DEMO_MODE=true enables /demo, /sim, mock OTP and demo login shortcuts.
DEMO_MODE=true
# Visit /demo?key=<DEMO_KEY> once to unlock the demo control panel on that browser.
DEMO_KEY=floodguard-demo
# Volunteer OTP accepted in demo mode.
DEMO_OTP=123456
# Speed of simulated volunteer movement (metres per real second).
DEMO_MOVE_SPEED_MPS=70

# ─── Messaging (SMS / USSD / Voice) ──────────────────────────────────────────
# mock = log everything to the outbox (visible in /demo and /sim), send nothing.
# africastalking = send for real (sandbox if AT_USERNAME=sandbox).
MESSAGING_PROVIDER=mock
AT_USERNAME=sandbox
AT_API_KEY=
# Optional alphanumeric sender ID / shortcode registered with Africa's Talking.
AT_SENDER_ID=
# Africa's Talking virtual number used as the caller ID for voice alerts.
AT_VOICE_NUMBER=
# Public URL of this deployment (used for webhook + voice audio URLs).
PUBLIC_BASE_URL=http://localhost:3000
# If set, webhooks require ?token=<WEBHOOK_SECRET> (configure the same in AT callback URLs).
WEBHOOK_SECRET=

# ─── Realtime (optional; recommended on Vercel) ──────────────────────────────
# When set, the server broadcasts "something changed" on a Supabase Realtime channel and
# dashboards refetch instantly. Without it, dashboards use a server-sent-events stream
# (works with `npm start`/docker) plus polling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Background tick ─────────────────────────────────────────────────────────
# Bearer token required by /api/tick when called by a scheduler (pg_cron, cron-job.org…).
# Leave empty to allow unauthenticated ticks (they are throttled and idempotent).
CRON_SECRET=

# ─── Routing (optional) ──────────────────────────────────────────────────────
# OpenRouteService key for safe routes that avoid flood polygons. Without it, FloodGuard
# draws a straight line and warns if it crosses flooded areas.
ORS_API_KEY=

# ─── Tuning ──────────────────────────────────────────────────────────────────
OFFER_TTL_SECONDS=120
ALERT_COOLDOWN_MINUTES=360
AUTOPILOT_ACCEPT_SECONDS=4
